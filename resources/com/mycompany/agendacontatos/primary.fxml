<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.agendacontatos.PrimaryController" prefWidth="900" prefHeight="600">
 <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
 <top>
  <VBox spacing="12">
   <Label text="HORIZON EARTH" styleClass="marca"/>
   <Label text="Agenda de contatos" styleClass="titulo"/>
   <Label text="Cadastre seus contatos ou selecione uma pessoa na tabela para editar."/>
   <GridPane hgap="12" vgap="10">
    <columnConstraints><ColumnConstraints minWidth="80"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
    <Label text="Nome *" GridPane.rowIndex="0"/>
    <TextField fx:id="campoNome" promptText="Nome completo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Label text="Telefone *" GridPane.rowIndex="1"/>
    <TextField fx:id="campoTelefone" promptText="(85) 99999-9999" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    <Label text="E-mail" GridPane.rowIndex="2"/>
    <TextField fx:id="campoEmail" promptText="Opcional" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
   </GridPane>
   <HBox spacing="10">
    <Button fx:id="botaoAdicionar" text="Adicionar" onAction="#adicionarContato" styleClass="primario"/>
    <Button fx:id="botaoSalvar" text="Salvar edição" onAction="#salvarEdicao" disable="true"/>
    <Button fx:id="botaoRemover" text="Remover" onAction="#removerContato" disable="true"/>
    <Button fx:id="botaoLimpar" text="Limpar campos" onAction="#limparCampos"/>
   </HBox>
   <TextField fx:id="campoBusca" promptText="Buscar pelo nome..."/>
   <Label fx:id="mensagem" text="Pronto para cadastrar." wrapText="true" minHeight="34"/>
   <padding><Insets bottom="12"/></padding>
  </VBox>
 </top>
 <center>
  <TableView fx:id="tabelaContatos">
   <placeholder><Label text="Nenhum contato encontrado."/></placeholder>
   <columns>
    <TableColumn fx:id="colunaNome" text="Nome" prefWidth="280"/>
    <TableColumn fx:id="colunaTelefone" text="Telefone" prefWidth="200"/>
    <TableColumn fx:id="colunaEmail" text="E-mail" prefWidth="330"/>
   </columns>
  </TableView>
 </center>
 <bottom>
  <HBox spacing="20">
   <padding><Insets top="12"/></padding>
   <Label fx:id="totalContatos" text="0 cadastrados"/>
   <Label text="Os contatos ficam em memória nesta versão."/>
  </HBox>
 </bottom>
</BorderPane>
